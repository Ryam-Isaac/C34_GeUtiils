import org.junit.Before;
import org.junit.Test;

import static org.junit.Assert.*;

public class GeoUtilsTest {
    Point p1;
    Point p2;
    Point p3;
    Point p4;
    Point p5;
    Point p6;
    Point p7;
    Point p8;
    Point p9;
    Point p10;
    Point p11;

    Segment s1;
    Segment s2;
    Segment s3;
    Segment s4;
    Segment s5;
    Segment s6;

    @Before
    public void setUp() throws Exception {
        p1 = new Point(-1,0);
        p2 = new Point(1,0);
        p3 = new Point(0,-1);
        p4 = new Point(0,1);

        p5 = new Point(0, 0);
        p6 = new Point(0.9, 0.9);

        p7 = new Point(2, 2);
        p8 = new Point(2, -2);

        p9 = new Point(1,1);

        p10 = new Point(4, 0);
        p11 = new Point(0, 4);

        s1 = new Segment(p1, p2);
        s2 = new Segment(p3, p4);

        s3 = new Segment(p1, p5);
        s4 = new Segment(p5, p6);

        s5 = new Segment(p7, p8);
        s6 = new Segment(p9, p7);
    }

    @Test
    public void prodVectPts1() {
        assertEquals(-2, GeoUtils.prodVectPts(p1, p2, p3), 0);
    }

    @Test
    public void prodVectPts2() {
        assertEquals(2, GeoUtils.prodVectPts(p1, p2, p4), 0);
    }

    @Test
    public void prodVectPts3() {
        assertEquals(0, GeoUtils.prodVectPts(p1, p2, p5),0);
    }

    @Test
    public void estSurSegment1() { assertFalse(GeoUtils.estSurSegment(s1, p10));}

    @Test
    public void estSurSegment2() { assertFalse(GeoUtils.estSurSegment(s2, p11));}

    @Test
    public void segmentCross1() {
        assertTrue(GeoUtils.segmentCross(s1, s2));
    }

    @Test
    public void segmentCross2() {
        assertTrue(GeoUtils.segmentCross(s3, s4));
    }

    @Test
    public void segmentCross3() {
        assertTrue(GeoUtils.segmentCross(s1, s4));
    }

    @Test
    public void segmentCross4() {
        assertTrue(GeoUtils.segmentCross(s5, s6));
    }

    @Test
    public void segmentCross5() {
        assertFalse(GeoUtils.segmentCross(s1, s6));
    }

    @Test
    public void segmentCross6() {
        assertFalse(GeoUtils.segmentCross(s2, s6));
    }

    @Test
    public void segmentCross7() {
        assertFalse(GeoUtils.segmentCross(s4, s6));
    }
}
