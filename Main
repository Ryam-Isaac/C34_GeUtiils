public class Main {
    public static void main(String[] args) {
        Point p1 = new Point(-1,0);
        Point p2 = new Point(1,0);
        Point p3 = new Point(0,-1);
        Point p4 = new Point(0,1);

        Point p5 = new Point(0, 0);
        Point p6 = new Point(0.9, 0.9);

        Point p7 = new Point(2, 2);
        Point p8 = new Point(2, -2);

        Point p9 = new Point(1,1);

        Segment s1 = new Segment(p1, p2);
        Segment s2 = new Segment(p3, p4);

        Segment s3 = new Segment(p1, p5);
        Segment s4 = new Segment(p5, p6);

        Segment s5 = new Segment(p7, p8);
        Segment s6 = new Segment(p9, p7);


        System.out.println(GeoUtils.prodVectPts(p1, p2, p3)); // -2
        System.out.println(GeoUtils.prodVectPts(p1, p2, p4)); // 2
        System.out.println(GeoUtils.prodVectPts(p1, p2, p5)); // 0
        System.out.println(GeoUtils.segmentCross(s1, s2)); // true
        System.out.println(GeoUtils.segmentCross(s3, s4)); // true
        System.out.println(GeoUtils.segmentCross(s1, s4)); // true
        System.out.println(GeoUtils.segmentCross(s5, s6)); // true
        System.out.println(GeoUtils.segmentCross(s1, s6)); //false
        System.out.println(GeoUtils.segmentCross(s2, s6)); //false
        System.out.println(GeoUtils.segmentCross(s4, s6)); //false
    }
}
