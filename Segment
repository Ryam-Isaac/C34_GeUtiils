import java.util.Objects;

public class Segment {
    private Point p1;
    private Point p2;

    public Segment(Point p1, Point p2){
        this.p1 = p1;
        this.p2 = p2;
    }

    public Point getP1() {
        return p1;
    }

    public void setP1(Point p1) {
        this.p1 = p1;
    }

    public Point getP2() {
        return p2;
    }

    public void setP2(Point p2) {
        this.p2 = p2;
    }

    @Override
    public boolean equals(Object obj) {
        if (this == obj) {
            return true;
        }
        if (obj == null || this.getClass() != obj.getClass()){
            return false;
        }
        Segment other = (Segment) obj;

        if (!other.getP1().equals(p1)) {
            return false;
        } else return other.getP2().equals(p2);
    }

    @Override
    public int hashCode() {
        return Objects.hash(this.p1, this.p2);
    }
}
